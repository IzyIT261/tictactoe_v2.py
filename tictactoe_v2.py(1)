#Psueoocode language of TicTacToe v2

Function Main
    Declare String Array board[9]
    Declare Integer i
    Declare String currentPlayer
    Declare Boolean gameOver
    Declare String winner
    Declare Integer move
    Declare Integer filledCount

    Assign gameOver = false
    Assign winner = "None"
    Declare Boolean validMove

    For i = 0 to 8
        Assign board[i] = " "
    End
    Assign i = Random(2)
    If i = 0
        Assign currentPlayer = "O"
    Else
        Assign currentPlayer = "X"
    End
    While gameOver = false
        Output board[0] & "|" & board[1] & "|" & board[2]
        Output "-+-+-"
        Output board[3] & "|" & board[4] & "|" & board[5]
        Output "-+-+-"
        Output board[6] & "|" & board[7] & "|" & board[8]
        If currentPlayer = "O"
            Assign validMove = false
            While validMove = false
                Input move
                If move >= 1 AND move <= 9
                    If board[move - 1] = " "
                        Assign validMove = true
                    Else
                        Output "That cell is already occupied. Try again."
                    End
                Else
                    Output "Invalid cell. Enter a number from 1 to 9"
                End
            End
        Else
            Assign validMove = false
            While validMove = false
                Assign move = Random(9) + 1
                If board[move - 1] = " "
                    Assign validMove = true
                End
            End
        End
        Assign board[move - 1] = currentPlayer
        Assign winner = "None"
        If board[0] != " " AND board[0] = board[1] AND board[1] = board[2]
            Assign winner = board[0]
        Else
            If board[3] != " " AND board[3] = board[4] AND board[4] = board[5]
                Assign winner = board[3]
            Else
                If board[6] != " " AND board[6] = board[7] AND board[7] = board[8]
                    Assign winner = board[6]
                Else
                    If board[0] != " " AND board[0] = board[3] AND board[3] = board[6]
                        Assign winner = board[0]
                    Else
                        If board[1] != " " AND board[1] = board[4] AND board[4] = board[7]
                            Assign winner = board[1]
                        Else
                            If board[2] != " " AND board[2] = board[5] AND board[5] = board[8]
                                Assign winner = board[2]
                            Else
                                If board[0] != " " AND board[0] = board[4] AND board[4] = board[8]
                                    Assign winner = board[0]
                                Else
                                    If board[2] != " " AND board[2] = board[4] AND board[4] = board[6]
                                        Assign winner = board[2]
                                    End
                                End
                            End
                        End
                    End
                End
            End
        End
        If winner != "None"
            Output winner & " wins!"
            Assign gameOver = true
        Else
            Assign filledCount = 0
            For i = 0 to 8
                If board[i] != " "
                    Assign filledCount = filledCount + 1
                End
            End
            If filledCount = 9
                Output "The game is a draw."
                Assign gameOver = true
            Else
                If currentPlayer = "O"
                    Assign currentPLayer = "X"
                Else
                    Assign currentPlayer = "O"
                End
            End
        End
    End
End
